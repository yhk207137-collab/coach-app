generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  CLIENT
}

enum ClientStatus {
  ACTIVE
  FROZEN
  ENDED
}

enum ClientType {
  SESSION
  RETAINER
  PROJECT
}

enum LeadStage {
  COLD
  WARM
  HOT
  PROPOSAL
  WON
  LOST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

enum SummaryType {
  STRUCTURED
  FREE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  clientId  String?  @unique
  client    Client?  @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id            String       @id @default(cuid())
  fullName      String
  phone         String?
  email         String       @unique
  businessName  String?
  businessField String?
  startDate     DateTime     @default(now())
  status        ClientStatus @default(ACTIVE)
  clientType    ClientType   @default(SESSION)
  monthlyFee    Float?
  notes         String?
  user          User?
  meetings      Meeting[]
  tasks         Task[]
  payments      Payment[]
  documents     Document[]
  quotes        Quote[]
  projects      Project[]
  contracts     Contract[]
  invoices      Invoice[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Meeting {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date          DateTime
  duration      Int
  type          String
  notes         String?
  googleEventId String?
  summary       MeetingSummary?
  tasks         Task[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model MeetingSummary {
  id          String      @id @default(cuid())
  meetingId   String      @unique
  meeting     Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  type        SummaryType @default(STRUCTURED)
  goal        String?
  progress    String?
  challenges  String?
  decisions   String?
  conclusions String?
  freeText    String?
  notes       String?
  documents   Document[]
  tags        Tag[]       @relation("SummaryTags")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Task {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  meetingId      String?
  meeting        Meeting?    @relation(fields: [meetingId], references: [id])
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id])
  subProjectId   String?
  subProject     SubProject? @relation(fields: [subProjectId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Payment {
  id              String          @id @default(cuid())
  clientId        String          @unique
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  totalAmount     Float
  paidAmount      Float           @default(0)
  nextPaymentDate DateTime?
  history         PaymentRecord[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model PaymentRecord {
  id            String    @id @default(cuid())
  paymentId     String
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount        Float
  date          DateTime  @default(now())
  note          String?
  isPaid        Boolean   @default(true)
  scheduledDate DateTime?
  paymentMethod String?
}

model Document {
  id        String          @id @default(cuid())
  clientId  String
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  summaryId String?
  summary   MeetingSummary? @relation(fields: [summaryId], references: [id])
  name      String
  mimeType  String
  url       String
  size      Int
  createdAt DateTime        @default(now())
}

model Tag {
  id        String           @id @default(cuid())
  name      String           @unique
  summaries MeetingSummary[] @relation("SummaryTags")
}

model MagicToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  EXPIRED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  REVISION
}

model Quote {
  id          String      @id @default(cuid())
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  number      Int         @default(autoincrement())
  status      QuoteStatus @default(DRAFT)
  notes       String?
  validUntil  DateTime?
  items       QuoteItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  strategy    String?
  goals       String?
  subProjects SubProject[]
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SubProject {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Contract {
  id            String         @id @default(cuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  content       String
  status        ContractStatus @default(DRAFT)
  signedAt      DateTime?
  signatureData String?
  signerName    String?
  signerIp      String?
  validUntil    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  duration    String?
  price       Float
  quantity    Int     @default(1)
  order       Int     @default(0)
}

model Lead {
  id             String         @id @default(cuid())
  fullName       String
  email          String?
  phone          String?
  company        String?
  source         String?
  stage          LeadStage      @default(COLD)
  notes          String?
  estimatedValue Float?
  activities     LeadActivity[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model LeadActivity {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  notes     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model Invoice {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number    Int           @default(autoincrement())
  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  notes     String?
  items     InvoiceItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  price       Float
  order       Int     @default(0)
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  unit        String   @default("חד-פעמי")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
